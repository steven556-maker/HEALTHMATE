{
  "name": "healthmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "vendor": "node scripts/vendor-mediapipe.mjs",
    "predev": "npm run vendor",
    "prebuild": "npm run vendor",
    "build": "npm run typecheck && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --local --port 8787 --var ALLOWED_ORIGIN:http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5184,http://127.0.0.1:5184",
    "lint": "eslint .",
    "check:env": "node scripts/check-build-env.mjs --dotenv .env",
    "dev": "vite --host 0.0.0.0",
    "serve": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.75.0",
    "openai": "^7.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^0.21.2",
    "wrangler": "^4.166.0"
  }
}
